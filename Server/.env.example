# Shared example for the Docker deployment forms. Copy to Server/.env and
# replace the domain and ACME email. Keep the APNs values unchanged when
# pairing the stock Drel App with the intentionally published community key.

# Native Go relay (docker-compose.self-hosted-native.yml)
DREL_SELF_HOSTED_NAME=Drel Self-hosted Push
DREL_SELF_HOSTED_PUBLIC_BASE_URL=https://push.example.com
DREL_APNS_KEY_HOST_PATH=./community-apns/AuthKey_4M53447M36.p8
DREL_CA_CERTIFICATES_HOST_PATH=/etc/ssl/certs/ca-certificates.crt
# Keep this default for the bundled 0644 key. For your own 0640 key, set the
# numeric GID that can read it.
# DREL_APNS_KEY_GID=65532
DREL_NATIVE_HOST_PORT=8080

# APNs provider identity for the stock Drel App and its community key. Native
# Compose maps DREL_APNS_KEY_HOST_PATH to the fixed in-container APNS_KEY_PATH.
APNS_ENVIRONMENT=production
APNS_TOPIC=com.webbridgekit.superapp
APNS_KEY_ID=4M53447M36
APNS_TEAM_ID=B45VZCNYU3

# Gateway settings. Generate GATEWAY_PRIVATE_KEY with:
#   openssl genpkey -algorithm ed25519
# Store only the Base64URL-encoded 32-byte seed in this variable.
ADMIN_API_KEY=TODO-generate-a-long-random-value
GATEWAY_ID=example-gateway
GATEWAY_NAME=Example Gateway
GATEWAY_PUBLIC_BASE_URL=https://push.example.com
GATEWAY_KEY_ID=TODO-generate-a-stable-id
GATEWAY_PRIVATE_KEY=TODO-paste-the-Base64URL-Ed25519-seed
