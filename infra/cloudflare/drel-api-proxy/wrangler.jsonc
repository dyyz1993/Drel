{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "drel-api-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.drel.app",
      "custom_domain": true
    }
  ],
  "vars": {
    // Swift-backend decommission (2026-10-26): the edge serves the whole API.
    // Unmatched paths answer a clean 404; restoring this variable re-enables
    // the legacy proxy in one deploy if a rollback is ever needed.
    // "UPSTREAM_ORIGIN": "https://wbk.shanbox.19930810.xyz:8443",
    "DREL_MANAGED_PUSH_MAX_DELIVERIES_PER_MINUTE": "60",
    // 2026.10.29-keybind: /api/v1/html-apps accepts deviceKey-bound private
    // registration without the admin key (paired-key check, 20/key cap,
    // private manifests visible only to ?key=<deviceKey> listings).
    // 2026-11-02: gate audio demo manifests by client action support.
    "DREL_EDGE_VERSION": "2026.11.08-route-schema",
    // OAuth v1 remains disabled until DREL_OAUTH_AT_EDGE is explicitly
    // changed to "1" in the deployment environment. Signing and admin
    // credentials stay secret; readiness is exposed through /health.
    "DREL_OAUTH_AT_EDGE": "0",
    "DREL_OAUTH_ATTESTATION_MODE": "apple-app-attest",
    "DREL_OAUTH_SIGNING_KEY_REGISTRY_VERSION": "1"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MANAGED_PUSH_REGISTRY",
        "class_name": "ManagedPushRegistry"
      },
      {
        "name": "GATEWAY_MANIFEST_REGISTRY",
        "class_name": "GatewayManifestRegistry"
      },
      {
        "name": "OFFICIAL_PUSH_REGISTRY",
        "class_name": "OfficialPushRegistry"
      },
      {
        "name": "APPROVAL_REGISTRY",
        "class_name": "ApprovalRegistry"
      },
      {
        "name": "DREL_OAUTH_GRANT_REGISTRY",
        "class_name": "OAuthGrantRegistry"
      },
      {
        "name": "DREL_OAUTH_RATE_LIMITER",
        "class_name": "OAuthRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-managed-encrypted-push",
      "new_sqlite_classes": ["ManagedPushRegistry"]
    },
    {
      "tag": "v2-html-app-gateway",
      "new_sqlite_classes": ["GatewayManifestRegistry"]
    },
    {
      "tag": "v3-official-push",
      "new_sqlite_classes": ["OfficialPushRegistry"]
    },
    {
      "tag": "v4-approval-state",
      "new_sqlite_classes": ["ApprovalRegistry"]
    },
    {
      "tag": "v5-drel-oauth-v1",
      "new_sqlite_classes": ["OAuthGrantRegistry", "OAuthRateLimiter"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
